  "scripts": {
    "generate": "npm run generate:components && npm run generate:icons && npm run generate:utilities",
    "generate:components": "node scripts/generate-components.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:utilities": "node scripts/generate-utilities.mjs",
    "check:generated": "node scripts/generate-components.mjs --check && node scripts/generate-icons.mjs --check && node scripts/generate-utilities.mjs --check",
    "check:docs-examples": "node scripts/check-doc-examples.mjs",
    "build": "npm run check:generated && vue-tsc -p tsconfig.build.json && vite build && node scripts/write-dist-package.mjs && node scripts/check-built-styles.mjs",
    "typecheck": "vue-tsc -p tsconfig.build.json",
    "lint": "eslint . && stylelint \"{src,docs,tests}/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"{src,docs,tests}/**/*.css\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:ssr": "vitest run --project ssr",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project chromium",
    "e2e:serve": "vite --config tests/e2e/fixture/vite.config.ts tests/e2e/fixture",
    "check:size": "node scripts/check-bundle-size.mjs",
    "test:consumer": "vue-tsc -p tsconfig.consumer.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "npm run format:check && npm run lint && npm run check:generated && npm run check:docs-examples && npm run typecheck && npm run test:coverage && npm run build && npm run test:consumer && npm run docs:build && npm run check:size",
    "check:release": "npm run check && npm run test:e2e && node scripts/check-release.mjs && npm audit --omit=dev",
    "prepublishOnly": "npm run build"
  },
